# 운영 화면 비밀번호. 필수이며 코드에 기본값이 없습니다. 비우면 로그인할 수 없습니다.
DASHBOARD_PASSWORD=
# 운영 화면 세션 서명 키. openssl rand -hex 32 등으로 생성합니다.
AUTH_SECRET=

# 공개 사이트 주소. 배포 때는 https 원점만 넣는다.
# 비우면 로컬 링크는 http://127.0.0.1:43117 을 쓴다. 그 주소로 검색에 올리지 않는다.
# 예: https://ritmore.example
NEXT_PUBLIC_SITE_URL=

# 검색 엔진 색인 스위치. 정확히 true 일 때만 공개 페이지 색인을 허용한다.
# 비우거나 true 가 아니면 noindex, nofollow 이고 robots.txt 가 전체를 막는다.
# 연습 상점은 false. 실제 공개 상점을 배포할 때만 true.
# NEXT_PUBLIC_ 값은 빌드에 박히므로 바꾼 뒤에는 다시 빌드한다.
NEXT_PUBLIC_SITE_INDEXABLE=false

# 검색 콘솔에서 받은 소유 확인 코드만 넣는다. 비우면 메타 태그를 만들지 않는다.
GOOGLE_SITE_VERIFICATION=
NAVER_SITE_VERIFICATION=
